<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mcv="clr-namespace:MauiCarouselView"
             x:Class="MauiCarouselView.MyTabbedPage"
             x:DataType="mcv:MyTabbedPage"
             x:Name="root">

    <ContentPage.Resources>
        <mcv:ItemTemplateSelector x:Key="TabSelector" TabbedPage="{x:Reference root}" />
    </ContentPage.Resources>

    <VerticalStackLayout>

        <Label Text="Swipe horizontally below to change views" HorizontalOptions="Center" />

        <CarouselView Margin="0,10,0,0" HorizontalScrollBarVisibility="Never"
                      ItemsSource="{Binding TabItems}"
                      ItemTemplate="{StaticResource TabSelector}" Loop="False" />

    </VerticalStackLayout>

</ContentPage>
